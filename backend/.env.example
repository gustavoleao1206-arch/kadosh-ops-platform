# Copie para .env (desenvolvimento). Em produção, estas variáveis ficam no painel do Render.

ENV=development
APP_TIMEZONE=America/Maceio

# Postgres local (portátil em X:\dev\pgsql, porta 5433 — a 5432 está ocupada nesta máquina)
DATABASE_URL=postgresql+psycopg://kadosh:kadosh_dev@localhost:5433/kadosh_dev

# Cookie só por HTTPS. Em produção (ENV=production) é forçado para true.
COOKIE_SECURE=false

# Documentação da API em /api/docs. Em produção é forçada para false.
DOCS_ENABLED=true

# IP real atrás do proxy (X-Forwarded-For). Vazio = automático (true em produção, false fora).
# TRUST_PROXY_HEADERS=

# Primeiro administrador — usado SÓ quando não existe nenhum usuário. Remova depois do primeiro login.
# ADMIN_EMAIL=voce@exemplo.com
# ADMIN_PASSWORD=troque-esta-senha-longa
